# Copia este archivo a .env y reemplaza los valores.
# .env esta en .gitignore: nunca se sube al repositorio.

# Contrasena del usuario sa de SQL Server.
# Requisitos: 8+ caracteres con mayusculas, minusculas, numeros y simbolos.
MSSQL_SA_PASSWORD=Password_Local123$

# Clave para firmar los JWT. Minimo 32 caracteres aleatorios.
# Generar una: openssl rand -base64 48
JWT_KEY=cambia-esta-clave-por-una-aleatoria-de-32-o-mas
